# Solana RPC endpoint (public endpoint is rate limited; use Helius/Triton/QuickNode for production)
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Jupiter API base URL. Free tier: https://lite-api.jup.ag
# With an API key you can use https://api.jup.ag (set the key too).
NEXT_PUBLIC_JUPITER_BASE_URL=https://lite-api.jup.ag
NEXT_PUBLIC_JUPITER_API_KEY=

# AI Otopilot (optional, server-side only — never exposed to the browser).
# When XAI_API_KEY is set, decisions are made by the Grok LLM through the xAI API;
# otherwise the built-in heuristic engine is used.
XAI_API_KEY=
# OpenAI-compatible endpoint and model overrides:
AI_BASE_URL=https://api.x.ai/v1
AI_MODEL=grok-4-fast
